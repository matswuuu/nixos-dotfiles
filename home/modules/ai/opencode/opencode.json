{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": true,
  "lsp": true,
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "opencode-claude-auth@latest"
  ],
  "tools": {
    "write": true,
    "bash": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "permission": {
    "external_directory": {
      "$HOME/**": "allow",
      "/tmp/**": "allow"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow"
  },
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "environment": {
        "CBM_ALLOWED_ROOT": "/home/matswuuu/IdeaProjects"
      },
      "enabled": true,
      "timeout": 60000
    }
  },
  "agent": {
    "orchestrator": {
      "description": "Coordinates complex development tasks by decomposing them into parallel specialized subtasks, integrating results, and verifying the final implementation.",
      "mode": "primary",

      "prompt": "{file:./prompts/orchestrator.md}",

      "permission": {
        "task": {
          "*": "deny",
          "researcher": "allow",
          "explorer": "allow",
          "implementer": "allow",
          "reviewer": "allow",
          "tester": "allow"
        },
        "edit": "allow",
        "bash": "allow"
      }
    },

    "researcher": {
      "description": "Researches external APIs, libraries, documentation, and technical approaches.",
      "mode": "subagent",
      "prompt": "{file:./prompts/researcher.md}",

      "permission": {
        "edit": "deny"
      }
    },

    "explorer": {
      "description": "Explores the existing codebase and identifies relevant files, architecture, dependencies, and implementation constraints.",
      "mode": "subagent",
      "prompt": "{file:./prompts/explorer.md}",

      "permission": {
        "edit": "deny"
      }
    },

    "implementer": {
      "description": "Implements an assigned, well-defined change in the codebase.",
      "mode": "subagent",
      "prompt": "{file:./prompts/implementer.md}",

      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny"
        }
      }
    },

    "reviewer": {
      "description": "Reviews the implementation for correctness, regressions, architecture, security, and maintainability.",
      "mode": "subagent",
      "prompt": "{file:./prompts/reviewer.md}",

      "permission": {
        "edit": "deny"
      }
    },

    "tester": {
      "description": "Runs relevant tests, builds, static analysis, and diagnostics and reports failures.",
      "mode": "subagent",
      "prompt": "{file:./prompts/tester.md}",

      "permission": {
        "edit": "deny"
      }
    }
  }
}
