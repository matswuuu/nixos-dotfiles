{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": true,
  "lsp": true,
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "tools": {
    "write": true,
    "bash": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "environment": {
        "CBM_ALLOWED_ROOT": "/home/matswuuu/IdeaProjects"
      },
      "enabled": true,
      "timeout": 60000
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "qwen3.8:27b"
        }
      }
    }
  }
}
